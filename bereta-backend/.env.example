# Copier en .env (ignoré par git) et remplir. Ne jamais committer de vraies valeurs.
DB_URL=jdbc:postgresql://<hôte>:5432/postgres
DB_USERNAME=
DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
# Facultatif (par défaut : JWT_SECRET)
OTP_HASH_SECRET=

BERETA_CORS_ALLOWED_ORIGINS=http://localhost:4200
BERETA_PASSWORD_RESET_BASE_URL=http://localhost:4200
# false uniquement en HTTP hors localhost ; true en production (HTTPS)
BERETA_REFRESH_COOKIE_SECURE=true

# log | brevo | twilio
BERETA_SMS_PROVIDER=log
SMS_SENDER=BERETA
BREVO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# log | smtp
BERETA_MAIL_PROVIDER=log
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Compte initial facultatif
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PHONE=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_NAME=
